  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "re2": "^1.27.0",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  }
}
